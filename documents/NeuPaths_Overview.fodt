        </draw:text-box>
       </draw:frame><draw:frame draw:style-name="gr48" draw:text-style-name="P61" svg:width="0.5004in" svg:height="0.3587in" svg:x="6.0472in" svg:y="1.9055in">
        <draw:text-box>
         <text:p text:style-name="P60"><text:span text:style-name="T170">S</text:span><text:span text:style-name="T171">8,2</text:span></text:p>
        </draw:text-box>
       </draw:frame><draw:frame draw:style-name="gr49" draw:text-style-name="P61" svg:width="0.4567in" svg:height="0.3594in" svg:x="1.2417in" svg:y="2.902in">
        <draw:text-box>
         <text:p text:style-name="P60"><text:span text:style-name="T170">S</text:span><text:span text:style-name="T171">i,j</text:span></text:p>
        </draw:text-box>
       </draw:frame><draw:frame draw:style-name="gr50" draw:text-style-name="P61" svg:width="2.3512in" svg:height="0.624in" svg:x="1.7331in" svg:y="2.8925in">
        <draw:text-box>
         <text:p text:style-name="P60"><text:span text:style-name="T170">Synapse </text:span><text:span text:style-name="T174">j</text:span><text:span text:style-name="T170"> for Cell </text:span><text:span text:style-name="T174">i</text:span><text:span text:style-name="T170"> where</text:span></text:p>
         <text:p text:style-name="P60"><text:span text:style-name="T174">j</text:span><text:span text:style-name="T170"> = {1, 2,…, </text:span><text:span text:style-name="T174">n</text:span><text:span text:style-name="T170">}</text:span></text:p>
        </draw:text-box>
       </draw:frame><draw:frame draw:style-name="gr51" draw:text-style-name="P61" svg:width="1.6307in" svg:height="0.5079in" svg:x="1.7331in" svg:y="2.1898in">
        <draw:text-box>
         <text:p text:style-name="P60"><text:span text:style-name="T170">Cell </text:span><text:span text:style-name="T174">i</text:span><text:span text:style-name="T170"> where</text:span></text:p>
         <text:p text:style-name="P60"><text:span text:style-name="T174">i</text:span><text:span text:style-name="T170"> = {1, 2,…, </text:span><text:span text:style-name="T174">m</text:span><text:span text:style-name="T170">}</text:span></text:p>
        </draw:text-box>
       </draw:frame><draw:line draw:style-name="gr3" draw:text-style-name="P59" svg:x1="1.1291in" svg:y1="3.2319in" svg:x2="1.6976in" svg:y2="3.2319in">
        <text:p/>
