   <text:p text:style-name="P11"/>
   <text:p text:style-name="P12"><text:span text:style-name="T84">NeuPaths</text:span><text:span text:style-name="T82"> </text:span><text:span text:style-name="T83">Overview</text:span></text:p>
   <text:p text:style-name="P6"/>
   <text:p text:style-name="P8"/>
   <text:p text:style-name="P8"/>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P5"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1" text:is-list-header="true"><text:bookmark-start text:name="__RefHeading___Toc11444_3344226754"/><text:soft-page-break/>Introduction<text:bookmark-end text:name="__RefHeading___Toc11444_3344226754"/></text:h>
   <text:p text:style-name="P57"><text:span text:style-name="T29">NeuPaths is a framework for event-driven, distributed, and parallel dataflow programming </text:span><text:span text:style-name="T53">that mimics the human nervous system. <text:s/>C</text:span><text:span text:style-name="T43">omputational tasks are performed by autonomous, distributed </text:span><text:span text:style-name="T28">Cells</text:span><text:span text:style-name="T43"> working in concert to process data. <text:s/></text:span><text:span text:style-name="T54">C</text:span><text:span text:style-name="T55">ells</text:span><text:span text:style-name="T31"> </text:span><text:span text:style-name="T30">are interconnected by </text:span><text:span text:style-name="T12">Synapses</text:span><text:span text:style-name="T31"> a</text:span><text:span text:style-name="T30">nd</text:span><text:span text:style-name="T31"> organized into </text:span><text:span text:style-name="T44">c</text:span><text:span text:style-name="T31">lusters </text:span><text:span text:style-name="T38">(see Figure 1.)</text:span><text:span text:style-name="T31"> <text:s/></text:span><text:span text:style-name="T30">The cells in a cluster </text:span><text:span text:style-name="T31">process </text:span><text:span text:style-name="T24">S</text:span><text:span text:style-name="T25">timuli</text:span><text:span text:style-name="T31"> that traverse the synapses, producing new stimuli in </text:span><text:span text:style-name="T45">response</text:span><text:span text:style-name="T31">. <text:s/></text:span><text:span text:style-name="T30">Clusters are also interconnected by synapses, and together form a </text:span><text:span text:style-name="T12">System</text:span><text:span text:style-name="T30">.</text:span></text:p>
   <text:p text:style-name="P57"><text:span text:style-name="T30"/></text:p>
   <text:p text:style-name="P58"><draw:frame draw:style-name="fr2" draw:name="Frame3" text:anchor-type="paragraph" svg:y="0.2272in" svg:width="4.8075in" draw:z-index="1">
     <draw:text-box fo:min-height="3.6516in">
