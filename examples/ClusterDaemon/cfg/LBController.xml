<load_controller_cell>
  <name>LBController</name>
  <synapses>
    <synapse>Local#Stream#Peer#Test#/tmp/router.syn</synapse>
  </synapses>
  <receptors>
    <receptor>
      <name>Request</name>
      <mode>non_buffered</mode>
      <stimulus_class>neupaths.stim.SignalStimulus</stimulus_class>
    </receptor>
  </receptors>
  <subscriptions>
    <map_subscription>
      <cell_name>TestInjector</cell_name>
      <transmitter_name>Request</transmitter_name>
      <domain>Test</domain>
      <filter_transactions>enabled</filter_transactions>
    </map_subscription>
  </subscriptions>
  <cell_name_prefix>LBC_</cell_name_prefix>
  <cell_domain>Test</cell_domain>
</load_controller_cell>
