           <text:p/>
           <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 3163 3163 0 10800 3163 18437 10800 21600 18437 18437 21600 10800 18437 3163" draw:text-areas="3163 3163 18437 18437" draw:type="ellipse" draw:enhanced-path="U 10800 10800 10800 10800 0 360 Z N"/>
          </draw:custom-shape>
         </draw:g><draw:custom-shape draw:style-name="gr50" draw:text-style-name="P184" svg:width="0.2307in" svg:height="0.2315in" svg:x="2.5307in" svg:y="1.5102in">
          <text:p/>
          <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="block-arc" draw:modifiers="180 5400" draw:enhanced-path="B 0 0 21600 21600 ?f4 ?f3 ?f2 ?f3 W ?f5 ?f5 ?f6 ?f6 ?f2 ?f3 ?f4 ?f3 Z N">
           <draw:equation draw:name="f0" draw:formula="10800*cos($0 *(pi/180))"/>
