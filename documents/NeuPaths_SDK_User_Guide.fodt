      <text:p text:style-name="P55">Figure <text:sequence text:ref-name="refFigure9" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">10</text:sequence>: WorldHello Data<text:span text:style-name="T372">f</text:span>low Model</text:p>
     </draw:text-box>
    </draw:frame><text:soft-page-break/></text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc11476_3344226754"/><text:span text:style-name="T298">WorldHello</text:span> <text:span text:style-name="T372">System</text:span> Model<text:bookmark-end text:name="__RefHeading___Toc11476_3344226754"/></text:h>
   <text:p text:style-name="Text_20_body">The <text:span text:style-name="T299">d</text:span>ata<text:span text:style-name="T299">f</text:span>low model is useful for defining “what goes where,” but it does not tell you “how it got there.” <text:s/>The <text:span text:style-name="T372">system</text:span> <text:span text:style-name="T299">m</text:span>odel identifies how each cell will participate in the <text:span text:style-name="T299">system</text:span>. <text:s/><text:span text:style-name="T183">For WorldHello, the most logical </text:span><text:span text:style-name="T372">system</text:span><text:span text:style-name="T183"> model matches the dataflow model exactly (see </text:span><text:span text:style-name="T303">f</text:span><text:span text:style-name="T183">igure </text:span><text:span text:style-name="T325">1</text:span><text:span text:style-name="T343">1</text:span><text:span text:style-name="T183">.) <text:s/>However, we also present alternative models to illustrate the flexibility of the </text:span><text:span text:style-name="T61">NeuPaths</text:span><text:span text:style-name="T183"> framework.</text:span><text:line-break/></text:p>
   <text:p text:style-name="Text_20_body"/>
   <text:p text:style-name="Text_20_body"><draw:frame draw:style-name="fr1" draw:name="Frame5" text:anchor-type="paragraph" svg:x="0.8654in" svg:y="0.1256in" svg:width="4.9409in" draw:z-index="14">
     <draw:text-box fo:min-height="3.9728in">
      <text:p text:style-name="P55"><draw:g text:anchor-type="paragraph" draw:z-index="15" draw:name="Group object 5" draw:style-name="gr10"><draw:g draw:style-name="gr4"><draw:g draw:style-name="gr4"><draw:custom-shape draw:style-name="gr2" draw:text-style-name="P182" svg:width="0.5004in" svg:height="0.5004in" svg:x="1.0937in" svg:y="1.8256in">
           <text:p/>
           <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 3163 3163 0 10800 3163 18437 10800 21600 18437 18437 21600 10800 18437 3163" draw:text-areas="3163 3163 18437 18437" draw:type="ellipse" draw:enhanced-path="U 10800 10800 10800 10800 0 360 Z N"/>
          </draw:custom-shape><draw:custom-shape draw:style-name="gr54" draw:text-style-name="P183" svg:width="0.3598in" svg:height="0.3598in" svg:x="1.1634in" svg:y="1.8972in">
           <text:p/>
           <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 3163 3163 0 10800 3163 18437 10800 21600 18437 18437 21600 10800 18437 3163" draw:text-areas="3163 3163 18437 18437" draw:type="ellipse" draw:enhanced-path="U 10800 10800 10800 10800 0 360 Z N"/>
          </draw:custom-shape>
